<Window x:Class="FanControlApp.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOA - Fan Control"
        Icon="/Icon.ico"
        Width="430" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnDrag">

    <Border BorderBrush="{DynamicResource PanelEdge}" BorderThickness="1">
        <Border Style="{StaticResource Card}" CornerRadius="0" Margin="0" Padding="24,20">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="BodyText" Margin="0,12,0,0" FontSize="12.5"
                           TextWrapping="Wrap" Foreground="{DynamicResource Text}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button x:Name="SecondaryButton" Content="Cancel" Margin="0,0,8,0"
                            MinWidth="90" Click="OnSecondaryClick" Visibility="Collapsed"
                            IsCancel="True" />
                    <Button x:Name="PrimaryButton" Content="OK" MinWidth="90"
                            Click="OnPrimaryClick" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
