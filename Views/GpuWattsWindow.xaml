<Window x:Class="FanControlApp.GpuWattsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOA - Fan Control"
        Icon="/Icon.ico"
        Width="430" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnDrag">

    <Border BorderBrush="{DynamicResource PanelEdge}" BorderThickness="1">
        <Border Style="{StaticResource Card}" CornerRadius="0" Margin="0" Padding="24,20">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Text="Your GPU isn't in the app's library yet" />

                <TextBlock x:Name="BodyText" Margin="0,12,0,0" FontSize="12.5"
                           TextWrapping="Wrap" Foreground="{DynamicResource Text}" />

                <Button x:Name="SearchButton" Margin="0,14,0,0" HorizontalAlignment="Center"
                        MaxWidth="360" Click="OnSearchClick">
                    <TextBlock x:Name="SearchButtonText" TextWrapping="Wrap" TextAlignment="Center" />
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBox x:Name="WattsBox" MinWidth="80" FontSize="14"
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             MaxLength="4" />
                    <TextBlock Text="watts" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" Foreground="{DynamicResource TextDim}" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="11.5"
                           TextWrapping="Wrap" Foreground="#F85149"
                           Visibility="Collapsed" HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="Skip" Margin="0,0,8,0" MinWidth="90"
                            Click="OnSkipClick" IsCancel="True" />
                    <Button Content="Save" MinWidth="90" Click="OnSaveClick" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
