<Window x:Class="FanControlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:FanControlApp.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TOA - Fan Control"
        Icon="/Icon.ico"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drawn here because DWM can't gradient a caption). -->
        <Border Grid.Row="0" Height="36"
                Background="{DynamicResource TitleFace}"
                BorderBrush="{DynamicResource PanelEdge}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Image Source="/Icon.ico" Width="18" Height="18"
                       Margin="10,0,9,0" DockPanel.Dock="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE921;" Click="OnMinimizeClick" ToolTip="Minimize to system tray" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE922;" Click="OnMaximizeClick" ToolTip="Maximise" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionClose}"
                            Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Close" />
                </StackPanel>

                <TextBlock x:Name="TitleText" Text="TOA - Fan Control" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Text}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- One live line: what the app does + what it's doing right now. -->
            <TextBlock x:Name="TopStatus" Grid.Row="0" Margin="2,0,2,12" FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextDim}"
                       Text="Case fans follow your hottest item" />

            <!-- The dash: CPU + GPU on top, then a dial per running fan (built in
                 code, 4 across, each row centred). Empty headers never appear.
                 Bars is the same information as compact sensor-panel rows -
                 Settings switches between the two, the behaviour never changes. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="8,12">
                <StackPanel>
                    <StackPanel x:Name="DialsPanel">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ctrl:Gauge x:Name="CpuGauge" Label="CPU" Unit="C" Width="200" Height="195"
                                        Minimum="0" Maximum="100" MajorTick="20" GreenTo="75" RedFrom="90" />
                            <ctrl:Gauge x:Name="GpuGauge" Label="GPU" Unit="C" Width="200" Height="195"
                                        Minimum="0" Maximum="100" MajorTick="20" GreenTo="75" RedFrom="90" />
                        </StackPanel>

                        <StackPanel x:Name="FanRows" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="BarsPanel" Visibility="Collapsed" MinWidth="460" Margin="4,4">
                        <!-- CPU + GPU share the line, like the dials share theirs. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ctrl:StatBar x:Name="CpuBar" Grid.Column="0" Label="CPU" Unit="C"
                                          GreenTo="75" RedFrom="90" />
                            <ctrl:StatBar x:Name="GpuBar" Grid.Column="1" Label="GPU" Unit="C"
                                          GreenTo="75" RedFrom="90"
                                          Margin="8,0,0,0" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BarTrackEdge}" Margin="6,4" />

                        <StackPanel x:Name="FanBarRows" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions, centred. The cog opens Settings: theme, hand-to-BIOS,
                 uninstall. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="GameModeButton" Content="Game Mode" Click="OnGameModeClick"
                        Margin="0,0,8,0"
                        ToolTip="Shrink to a small always-on-top readout. Needs the game in Windowed Fullscreen / Borderless - nothing can draw over exclusive fullscreen." />
                <Button x:Name="ResetPeaksButton" Content="Reset peaks"
                        Click="OnResetPeaksClick" Margin="0,0,8,0" />
                <!-- Explicit TextBlock: a string Content would get the implicit
                     TextBlock style's Segoe UI and render the gear as a tofu box. -->
                <Button x:Name="SettingsButton" Padding="8,6"
                        Click="OnSettingsClick" ToolTip="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
