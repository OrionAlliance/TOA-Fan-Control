<Window x:Class="FanControlApp.GameModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOA - Fan Control (Game Mode)"
        Width="268" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Text}">

    <!-- Card gradient and bevel, same as everything else, just small. -->
    <Border Background="{DynamicResource TitleFace}"
            BorderBrush="{DynamicResource CardEdge}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            MouseLeftButtonDown="OnDragOrRestore">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- CPU -->
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="CPU" Foreground="{DynamicResource TextDim}" FontSize="9"
                           VerticalAlignment="Bottom" Margin="0,0,4,2" />
                <TextBlock x:Name="CpuText" Text="--" FontSize="19" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="CpuPeakText" Grid.Row="1" Grid.Column="0" FontSize="9"
                       Foreground="{DynamicResource TextDim}" Text="peak --" />

            <!-- GPU -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="GPU" Foreground="{DynamicResource TextDim}" FontSize="9"
                           VerticalAlignment="Bottom" Margin="0,0,4,2" />
                <TextBlock x:Name="GpuText" Text="--" FontSize="19" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="GpuPeakText" Grid.Row="1" Grid.Column="1" FontSize="9"
                       Foreground="{DynamicResource TextDim}" Text="peak --" />

            <!-- Fans -->
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="FAN" Foreground="{DynamicResource TextDim}" FontSize="9"
                           VerticalAlignment="Bottom" Margin="0,0,4,2" />
                <TextBlock x:Name="FanText" Text="--" FontSize="19" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="RpmText" Grid.Row="1" Grid.Column="2" FontSize="9"
                       Foreground="{DynamicResource TextDim}" Text="-- / --" />

            <!-- Way back to the full window. E7F4 is Segoe MDL2's monitor-on-a-stand;
                 picked by rendering the font rather than trusting a hex code from
                 memory - the previous E73F was the "FullScreen" arrows, which read as
                 a faint empty square at this size. -->
            <Button x:Name="RestoreButton" Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                    Padding="0" Width="28" Height="28" VerticalAlignment="Center"
                    Click="OnRestoreClick"
                    ToolTip="Back to the full window (or double-click anywhere)">
                <!-- Explicit TextBlock so the glyph can't fall to the implicit
                     Segoe UI style and render as a tofu box. -->
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
            </Button>
        </Grid>
    </Border>
</Window>
