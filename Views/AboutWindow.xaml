<Window x:Class="FanControlApp.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOA - Fan Control · About"
        Icon="/Icon.ico"
        Width="470" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="OnDrag">

    <Border BorderBrush="{DynamicResource PanelEdge}" BorderThickness="1">
        <Border Style="{StaticResource Card}" CornerRadius="0" Margin="0" Padding="24,20">
            <StackPanel>
                <TextBlock x:Name="TitleLine" Text="TOA - Fan Control" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Margin="0,6,0,0" FontSize="12">
                    <Run Text="Source code, updates &amp; support: " />
                    <Hyperlink NavigateUri="https://github.com/OrionAlliance/TOA-Fan-Control"
                               RequestNavigate="OnLinkClick"
                               Foreground="{DynamicResource Accent}">github.com/OrionAlliance/TOA-Fan-Control</Hyperlink>
                </TextBlock>

                <!-- What-it-does, in the same accent callout as the privacy box. -->
                <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{DynamicResource Accent}"
                        Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="What it does." FontSize="12.5" FontWeight="SemiBold" />

                        <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"
                                   Text="The app works by adjusting ONLY your PC case fans to follow your hottest item. Either your CPU or your GPU. Every second, the app reads the CPU and GPU temperatures and sets every case fan to match the hotter of the two, one-to-one: 70°C means 70% fan speed. Past 70°C the fans lean up to 5 points ahead of the temperature (78°C means 83%) for extra push when things are hottest." />

                        <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"
                                   Text="A hard 30% floor means no case fan ever stalls and changes are rate-limited so fans glide to the needed speed instead of jerking up or down in RPM." />

                        <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"
                                   Text="Your AIO pumps/CPU coolers and GPU fans are never touched - they stay on your motherboard's BIOS control." />

                        <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"
                                   Text="Closing the app always hands the fans back to the BIOS: a watchdog process guarantees the handoff even if the app is force-killed." />

                        <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"
                                   Text="The PawnIO driver (signed, by namazso) provides hardware access. PawnIO, .NET, and the app itself are checked for updates automatically - never during a game - and the app restarts itself so updates take effect right away." />
                    </StackPanel>
                </Border>

                <!-- The privacy promise, in its own callout so it can't be missed. -->
                <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{DynamicResource Accent}"
                        Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Your data stays yours." FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"
                                   Text="This app collects NOTHING and transmits NOTHING: no telemetry, no analytics, no accounts, no personal data - there isn't even a server to send anything to. Temperatures and fan speeds are read from your hardware, shown on screen, and written only to a local log file next to the app. The app's only internet use is checking for updates (PawnIO from its author's GitHub, .NET from Microsoft and the app itself from GitHub), and those requests send nothing about you or your PC." />
                    </StackPanel>
                </Border>

                <Border Height="1" Background="{DynamicResource PanelEdge}" Margin="0,16,0,0" />

                <TextBlock x:Name="CopyrightLine" Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap">
                    <Run Text="© 2026 TOA. Released under the " />
                    <Hyperlink NavigateUri="https://github.com/OrionAlliance/TOA-Fan-Control/blob/main/LICENSE"
                               RequestNavigate="OnLinkClick"
                               Foreground="{DynamicResource Accent}">GNU GPLv3</Hyperlink><Run Text=" - free forever, and every fork must stay free and open source too." />
                </TextBlock>

                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDim}"
                           Text="This software is provided &quot;as is&quot;, without warranty of any kind, express or implied. It controls real hardware - your fans - and while it is designed to always return them to motherboard (BIOS) control and never drive them below a safe floor, you use it at your own risk. TOA is not liable for any damage to hardware, loss of data, or any other damages arising from the use of this software." />

                <Button Content="Close" HorizontalAlignment="Center" Margin="0,18,0,0"
                        MinWidth="90" Click="OnCloseClick" />
            </StackPanel>
        </Border>
    </Border>
</Window>
