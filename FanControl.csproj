<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TOA - Fan Control</AssemblyName>
    <RootNamespace>FanControlApp</RootNamespace>
    <Version>1.18.21</Version>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window/taskbar icon. ApplicationIcon above only covers the exe in Explorer. -->
    <Resource Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only for the tray icon; drop its global usings so WPF type names stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tools\ holds hand-run dev tools with their own Main; excluded to avoid multiple entry points. -->
    <Compile Remove="Tools\**" />
    <Page Remove="Tools\**" />
    <Resource Remove="Tools\**" />
    <None Remove="Tools\**" />

    <!-- The installer is its own project (Setup\Setup.csproj), kept out of the app build. -->
    <Compile Remove="Setup\**" />
    <Page Remove="Setup\**" />
    <Resource Remove="Setup\**" />
    <EmbeddedResource Remove="Setup\**" />
    <None Remove="Setup\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.9.6 uses PawnIO, not Defender-blocked WinRing0; needs PawnIO installed or no fan sensors appear. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
