<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TOA - Fan Control</AssemblyName>
    <RootNamespace>FanControlApp</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window/taskbar icon. ApplicationIcon above only covers the exe in Explorer. -->
    <Resource Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-run dev tools, each with its own Main - keep them out of the app's
         compile or the build breaks on multiple entry points.
           IconGen\      draws Icon.ico, plus a proof sheet of every size
           GaugePreview\ renders the real gauge cluster offscreen to a PNG, so
                         layout can be looked at instead of guessed at
           GlyphSheet\   renders a labelled sheet of a symbol font, so a glyph
                         gets picked by looking rather than by guessing a hex code -->
    <Compile Remove="IconGen\**" />
    <Compile Remove="GaugePreview\**" />
    <Compile Remove="GlyphSheet\**" />
    <Page Remove="GaugePreview\**" />
    <Page Remove="GlyphSheet\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- PINNED. Do not bump without re-testing on the actual board.
         0.9.6 fails to detect the Nuvoton NCT6798D on this X570 entirely: the
         Motherboard node comes back with zero sub-hardware, so every fan except
         the GPU's disappears and the app silently drives nothing. 0.9.4 finds
         all 7 headers and reads/writes them correctly. Verified A/B on this
         machine 2026-07-16. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

</Project>
