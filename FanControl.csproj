<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TOA - Fan Control</AssemblyName>
    <RootNamespace>FanControlApp</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window/taskbar icon. ApplicationIcon above only covers the exe in Explorer. -->
    <Resource Include="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- IconGen\ is the source that draws Icon.ico - a separate little exe, run by
         hand when the icon changes. It has its own Main, so keep it out of the app's
         compile or the build breaks on two entry points. -->
    <Compile Remove="IconGen\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- PINNED. Do not bump without re-testing on the actual board.
         0.9.6 fails to detect the Nuvoton NCT6798D on this X570 entirely: the
         Motherboard node comes back with zero sub-hardware, so every fan except
         the GPU's disappears and the app silently drives nothing. 0.9.4 finds
         all 7 headers and reads/writes them correctly. Verified A/B on this
         machine 2026-07-16. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

</Project>
