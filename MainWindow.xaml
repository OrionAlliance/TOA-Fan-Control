<Window x:Class="FanControlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:FanControlApp.Controls"
        Title="TOA - Fan Control"
        Height="720" Width="900"
        MinHeight="620" MinWidth="760"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="TOA - Fan Control" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="EngagedBadge" DockPanel.Dock="Right"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource TextDim}"
                       Text="BIOS has the fans" />
        </DockPanel>

        <!-- Live readouts -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,14">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="{StaticResource TextDim}" FontSize="11" />
                    <TextBlock x:Name="CpuTempText" Text="--" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="CpuTempName" Text="" Foreground="{StaticResource TextDim}" FontSize="10" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="GPU" Foreground="{StaticResource TextDim}" FontSize="11" />
                    <TextBlock x:Name="GpuTempText" Text="--" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="GpuTempName" Text="" Foreground="{StaticResource TextDim}" FontSize="10" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="FAN OUTPUT" Foreground="{StaticResource TextDim}" FontSize="11" />
                    <TextBlock x:Name="OutputText" Text="--" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceText" Text="" Foreground="{StaticResource TextDim}" FontSize="10" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Mode -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="MODE" Foreground="{StaticResource TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,14,0" />

                <RadioButton x:Name="ManualRadio" Content="Manual - I draw the curve"
                             Foreground="{StaticResource Text}" VerticalAlignment="Center"
                             Margin="0,0,20,0" GroupName="Mode"
                             Checked="OnModeChanged" />

                <RadioButton x:Name="AutoRadio" Content="Auto - app holds a target temp"
                             Foreground="{StaticResource Text}" VerticalAlignment="Center"
                             GroupName="Mode" Checked="OnModeChanged" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Drive fans from:" Foreground="{StaticResource TextDim}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SourceCombo" Width="130" VerticalAlignment="Center"
                              SelectionChanged="OnSourceChanged">
                        <ComboBoxItem Content="Hotter of the two" />
                        <ComboBoxItem Content="CPU only" />
                        <ComboBoxItem Content="GPU only" />
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Manual: the curve -->
        <Border x:Name="ManualPanel" Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource TextDim}" FontSize="11"
                           Margin="0,0,0,8"
                           Text="Drag a dot to move it  ·  double-click empty space to add one  ·  right-click a dot to delete" />
                <ctrl:CurveEditor x:Name="Curve" />
            </DockPanel>
        </Border>

        <!-- Auto: the target -->
        <Border x:Name="AutoPanel" Grid.Row="3" Style="{StaticResource Card}"
                Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="Hold this temperature" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,18"
                           Text="The app watches the temperature and adjusts the case fans on its own to settle here. Runs hotter than this and the fans climb; cooler and they ease back off." />

                <TextBlock x:Name="TargetText" Text="65 C" FontSize="42" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <Slider x:Name="TargetSlider" Minimum="45" Maximum="85" TickFrequency="5"
                        IsSnapToTickEnabled="True" Margin="0,10,0,0"
                        ValueChanged="OnTargetChanged" />

                <DockPanel Margin="0,2,0,0">
                    <TextBlock Text="45 C (loud, cold)" Foreground="{StaticResource TextDim}" FontSize="10" />
                    <TextBlock Text="85 C (quiet, hot)" Foreground="{StaticResource TextDim}" FontSize="10"
                               HorizontalAlignment="Right" />
                </DockPanel>

                <TextBlock x:Name="AutoStateText" Margin="0,22,0,0" FontSize="12"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" />
            </StackPanel>
        </Border>

        <!-- Fans -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FANS" Foreground="{StaticResource TextDim}"
                           FontSize="11" Margin="0,0,0,8" />
                <ItemsControl x:Name="FanList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="{Binding Name}" FontSize="11"
                                           Foreground="{Binding NameBrush}" />
                                <TextBlock Text="{Binding Reading}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{Binding ValueBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Status -->
        <DockPanel Grid.Row="5">
            <Button x:Name="ReleaseButton" DockPanel.Dock="Right" Content="Release to BIOS"
                    Click="OnReleaseClick" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextDim}" Text="Starting..." />
        </DockPanel>

    </Grid>
</Window>
