<UserControl x:Class="FanControlApp.Controls.StatBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="27">
    <!-- AIDA-panel style: name (and a fan's RPM) live INSIDE the bar, the value
         sits OUTSIDE at the right. The track keeps the dashboard's dark machined
         face in either theme, same as the dials and fan tiles. -->
    <Grid Margin="6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="TrackHost" Grid.Column="0" VerticalAlignment="Center" Height="22">
            <Border x:Name="Track" VerticalAlignment="Stretch"
                    CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource BarTrackEdge}"
                    Background="{DynamicResource BarTrack}" />

            <!-- Fill clipped to the track's rounded inside. -->
            <Border Margin="1" CornerRadius="4" ClipToBounds="True">
                <Border x:Name="Fill" HorizontalAlignment="Left" CornerRadius="4"
                        Width="0" />
            </Border>

            <!-- In-bar text twice: a white layer over the dark track, and a black
                 layer clipped to the fill's width. Wherever the fill reaches you
                 see black; past its edge, white. Laid out identically. -->
            <Grid x:Name="TextWhiteLayer">
                <TextBlock x:Name="LabelTextW" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="9,0,0,0" FontSize="11.5" FontWeight="Bold"
                           Foreground="{DynamicResource BarTrackText}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid x:Name="TextBlackLayer">
                <TextBlock x:Name="LabelTextB" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="9,0,0,0" FontSize="11.5" FontWeight="Bold" Foreground="Black"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Peak-this-run marker, the bar version of the dials' yellow tick. -->
            <Rectangle x:Name="PeakTick" Width="2" RadiusX="1" RadiusY="1"
                       HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,1"
                       Fill="#E3B341" Visibility="Collapsed"
                       ToolTipService.InitialShowDelay="200" />
        </Grid>

        <!-- The reading, outside the bar - coloured by zone like the dials' number. -->
        <!-- Right-aligned so every row's reading ends on the same vertical line:
             the temp's "C" sits directly above the RPM's last digit. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ValueText" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="Bold" Foreground="White" Text="--" />
            <!-- Optional live secondary reading (a fan's RPM), one space after the
                 value: "37%  RPM: 706". Its jitter is the bar view's heartbeat. -->
            <TextBlock x:Name="TrailTextBlock" VerticalAlignment="Center" Margin="5,0,0,0"
                       FontSize="10.5" Foreground="{DynamicResource TextDim}"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
