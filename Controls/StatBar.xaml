<UserControl x:Class="FanControlApp.Controls.StatBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34">
    <!-- Name inside the bar, value outside at the right; the track stays dark in both themes. -->
    <Grid Margin="6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="TrackHost" Grid.Column="0" VerticalAlignment="Bottom" Height="22" Margin="0,0,0,2">
            <Border x:Name="Track" VerticalAlignment="Stretch"
                    CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource BarTrackEdge}"
                    Background="{DynamicResource BarTrack}" />

            <!-- Fill clipped to the track's rounded inside. -->
            <Border Margin="1" CornerRadius="4" ClipToBounds="True">
                <Border x:Name="Fill" HorizontalAlignment="Left" CornerRadius="4"
                        Width="0" />
            </Border>

            <!-- Text drawn twice: white over the track, black clipped to the fill, laid out identically. -->
            <Grid>
                <TextBlock x:Name="LabelTextW" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="9,0,0,0" FontSize="11.5" FontWeight="Bold"
                           Foreground="{DynamicResource BarTrackText}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid x:Name="TextBlackLayer">
                <TextBlock x:Name="LabelTextB" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="9,0,0,0" FontSize="11.5" FontWeight="Bold" Foreground="Black"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Peak value this run, like the dials' yellow tick. -->
            <Rectangle x:Name="PeakTick" Width="2" RadiusX="1" RadiusY="1"
                       HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,1"
                       Fill="#E3B341" Visibility="Collapsed"
                       ToolTipService.InitialShowDelay="200" />

            <!-- Peak load this session, in load blue. -->
            <Rectangle x:Name="LoadPeakTick" Width="2" RadiusX="1" RadiusY="1"
                       HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,1"
                       Fill="#4DEEFF" Visibility="Collapsed"
                       ToolTipService.InitialShowDelay="200" />

        </Grid>

        <!-- Live-load triangle above the bar, tip down at the current load. -->
        <Polygon x:Name="LoadTri" Grid.Column="0" Points="0,0 9,0 4.5,7" Fill="#00A3C4"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                 Visibility="Collapsed" Cursor="Hand"
                 ToolTipService.InitialShowDelay="200" />

        <!-- Zone-coloured reading, right-aligned so every row ends on the same line. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="6,0,0,5" VerticalAlignment="Bottom">
            <TextBlock x:Name="ValueText" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="Bold" Foreground="White" Text="--" />
            <!-- Optional secondary reading, such as a fan's RPM. -->
            <TextBlock x:Name="TrailTextBlock" VerticalAlignment="Center" Margin="5,0,0,0"
                       FontSize="10.5" Foreground="{DynamicResource TextDim}"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
