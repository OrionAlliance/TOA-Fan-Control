<UserControl x:Class="FanControlApp.Controls.Gauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <!-- Dial face, rebuilt only when the size changes. -->
        <Canvas x:Name="Face" />

        <!-- Needle and peak mark, built once and rotated. -->
        <Canvas x:Name="Moving" />
    </Grid>
</UserControl>
