<UserControl x:Class="FanControlApp.Controls.FanBlade"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <!-- Static frame, screws and recess. -->
        <Canvas x:Name="FrameLayer" />

        <!-- Blades; the whole layer spins about the hub. -->
        <Canvas x:Name="BladeLayer" />

        <!-- Static hub cap with the readout on top. -->
        <Canvas x:Name="HubLayer" />
    </Grid>
</UserControl>
