<Window x:Class="FanControlApp.FanPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOA - Fan Control · Choose fans"
        Icon="Icon.ico"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnDrag">

    <Border BorderBrush="{DynamicResource PanelEdge}" BorderThickness="1">
        <Border Style="{StaticResource Card}" CornerRadius="0" Margin="0" Padding="24,20">
            <StackPanel>
                <TextBlock Text="Which fans should the app drive?" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Margin="0,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Text="These are the case-fan headers found on this PC. The checked ones will follow your hottest component. Uncheck anything that is NOT a regular case fan - for example a liquid-cooler pump plugged into a generically named header." />

                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDim}"
                           Text="Pumps, CPU coolers, chipset and GPU fans the app can recognize by name are never driven and aren't listed here. RPM is shown to help you tell which is which." />

                <StackPanel x:Name="FanList" Margin="4,14,0,0" />

                <TextBlock x:Name="FootnoteText" Margin="0,12,0,0" FontSize="11"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextDim}"
                           Visibility="Collapsed"
                           Text="Changes take effect the next time the app starts." />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0"
                            Click="OnCancelClick" Visibility="Collapsed" />
                    <Button x:Name="SaveButton" Content="Save" MinWidth="100" Click="OnSaveClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
