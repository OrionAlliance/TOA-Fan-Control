<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for FolderBrowserDialog (the Browse button). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TOA - Fan Control Setup</AssemblyName>
    <RootNamespace>FanControlSetup</RootNamespace>
    <Version>1.11.2</Version>
    <ApplicationIcon>..\Icon.ico</ApplicationIcon>

    <!-- Own Main in Program.cs, no App.xaml. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>FanControlSetup.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drop WinForms global usings so WPF types stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icon must be an embedded resource to resolve at runtime. -->
    <Resource Include="..\Icon.ico" Link="Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the app's verified PawnIO installer and helpers so both install the driver the same way. -->
    <Compile Include="..\Cooling\PawnIoSetup.cs" Link="Shared\PawnIoSetup.cs" />
    <Compile Include="..\Infrastructure\DotNetUpdate.cs" Link="Shared\DotNetUpdate.cs" />
    <Compile Include="..\Infrastructure\DebugLog.cs" Link="Shared\DebugLog.cs" />
    <Compile Include="..\Infrastructure\AppPaths.cs" Link="Shared\AppPaths.cs" />
    <Compile Include="..\Infrastructure\FolderLock.cs" Link="Shared\FolderLock.cs" />
    <Compile Include="..\Infrastructure\Downloads.cs" Link="Shared\Downloads.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded app exe, copied into payload\ by Build-Setup.ps1 before this builds. -->
    <EmbeddedResource Include="payload\TOA - Fan Control.exe">
      <LogicalName>app.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
