<Window x:Class="FanControlSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TOA - Fan Control · Setup"
        Icon="Icon.ico"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#0E1116" Foreground="#FFFFFF"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#20283A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#38425A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A344A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#0B0D12" BorderThickness="1">
        <Border Background="#161A22" Padding="24,22">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Text="Setting up TOA - Fan Control"
                           FontSize="18" FontWeight="SemiBold" />

                <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="13"
                           Foreground="#FFFFFF" TextWrapping="Wrap"
                           Text="Getting things ready…" />

                <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,0"
                             IsIndeterminate="True"
                             Background="#242938" Foreground="#4F8CFF" BorderThickness="0" />

                <StackPanel x:Name="Buttons" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,20,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="SecondaryButton" Content="Quit"
                            Margin="0,0,8,0" Click="OnSecondaryClick" Visibility="Collapsed" />
                    <Button x:Name="PrimaryButton" Content="OK"
                            Click="OnPrimaryClick" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
